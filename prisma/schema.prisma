// Modelo de datos del catálogo.
// Las fotos NO se guardan en la base de datos: aquí solo va su información
// (clave en el almacenamiento, tamaño, texto alternativo, orden). Los archivos
// viven en el bucket S3 (MinIO en local, Cloudflare R2 en producción).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Coleccion {
  id               String    @id @default(cuid())
  slug             String    @unique
  nombre           String
  temporada        String? // p. ej. "Primavera 2026"
  descripcion      String?
  // Textos editoriales de la página de la colección (opcionales).
  historia         String? // cómo nació la colección
  inspiracion      String? // qué la inspiró
  materiales       String? // telas y materiales que usa
  publicada        Boolean   @default(false)
  fechaLanzamiento DateTime?
  orden            Int       @default(0)

  prendas Prenda[]
  // Fotos de campaña / lookbook (opcionales).
  fotos   Foto[]   @relation("FotosColeccion")
  eventos Evento[]

  // Portada elegida en el panel: normalmente la foto de una de sus prendas, para no subirla dos veces.
  portadaId String?
  portada   Foto?   @relation("PortadaColeccion", fields: [portadaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicada, fechaLanzamiento])
}

model Categoria {
  id     String @id @default(cuid())
  slug   String @unique
  nombre String
  orden  Int    @default(0)

  prendas Prenda[]
}

model Prenda {
  id          String   @id @default(cuid())
  slug        String   @unique
  nombre      String
  descripcion String?
  precio      Int? // en pesos, sin decimales. Opcional: el catálogo puede mostrarse sin precios.
  tallas      String[] // p. ej. ["XS", "S", "M", "L"]
  colores     String[] // p. ej. ["Negro", "Arena"]
  // Detalles de la ficha (opcionales).
  materiales    String? // p. ej. "100 % lino"
  cuidados      String? // p. ej. "Lavar a mano con agua fría"
  medidasModelo String? // p. ej. "La modelo mide 1,70 y usa talla S"
  disponible  Boolean  @default(true)
  destacada   Boolean  @default(false)
  orden       Int      @default(0)

  coleccionId String
  coleccion   Coleccion  @relation(fields: [coleccionId], references: [id], onDelete: Restrict)
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  // La primera (menor `orden`) es la foto principal.
  fotos      Foto[]
  eventos    Evento[]
  reacciones Reaccion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coleccionId, orden])
  @@index([categoriaId])
}

model Foto {
  id    String @id @default(cuid())
  // Prefijo en el bucket. Cada foto tiene 3 variantes WebP:
  // `${clave}/sm.webp` (480px), `${clave}/md.webp` (960px), `${clave}/lg.webp` (1600px).
  clave String @unique
  alt   String @default("")
  ancho Int // dimensiones de la variante más grande
  alto  Int
  // Miniatura diminuta en base64 para mostrar un desenfoque mientras carga la foto.
  blurDataUrl String
  bytes       Int // peso total de las 3 variantes, para controlar el uso del almacenamiento
  orden       Int    @default(0)

  // Una foto pertenece a una prenda o a una colección (lookbook), nunca a ambas.
  prendaId    String?
  prenda      Prenda?    @relation(fields: [prendaId], references: [id], onDelete: Cascade)
  coleccionId String?
  coleccion   Coleccion? @relation("FotosColeccion", fields: [coleccionId], references: [id], onDelete: Cascade)

  // Colecciones que usan esta foto como portada.
  portadaDe Coleccion[] @relation("PortadaColeccion")
  // Si es la foto de «Sobre la marca».
  tienda    Tienda?     @relation("FotoTienda")

  createdAt DateTime @default(now())

  @@index([prendaId, orden])
  @@index([coleccionId, orden])
}

// «Sobre Solena»: una sola fila con cómo nació la marca y quién la fundó.
model Tienda {
  id       String  @id @default("solena")
  titulo   String? // frase de presentación, p. ej. "Ropa hecha a mano en Valledupar"
  historia String? // cómo nació Solena

  // Quién está detrás: su foto (fotoId), nombre, cargo y su propio texto.
  fundadoraNombre String?
  fundadoraCargo  String? // p. ej. "Fundadora y diseñadora"
  fundadoraTexto  String?
  fotoId   String? @unique
  foto     Foto?   @relation("FotoTienda", fields: [fotoId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt
}

// --- Métricas del catálogo -------------------------------------------------
// Sin datos personales: `visitante` es un código al azar que el navegador guarda
// en una cookie. Sirve para contar personas distintas, no para saber quiénes son.

enum TipoEvento {
  VISITA // abrió una página del catálogo
  WHATSAPP // tocó un botón para escribir por WhatsApp
}

model Evento {
  id        String     @id @default(cuid())
  tipo      TipoEvento
  visitante String
  dia       DateTime   @db.Date // día en hora de Colombia
  ruta      String // "/", "/colecciones/<slug>" o "/prendas/<slug>"

  prendaId    String?
  prenda      Prenda?    @relation(fields: [prendaId], references: [id], onDelete: SetNull)
  coleccionId String?
  coleccion   Coleccion? @relation(fields: [coleccionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Una misma persona cuenta una vez por página y por día, aunque recargue.
  @@unique([tipo, visitante, dia, ruta])
  @@index([dia, tipo])
  @@index([prendaId])
}

// Corazón de un visitante a una prenda. Quitar el corazón borra la fila.
model Reaccion {
  prendaId  String
  prenda    Prenda   @relation(fields: [prendaId], references: [id], onDelete: Cascade)
  visitante String
  createdAt DateTime @default(now())

  @@id([prendaId, visitante])
  @@index([createdAt])
}
