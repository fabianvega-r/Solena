# Copia este archivo como .env y ajusta los valores.
# Los valores de abajo funcionan con `docker compose up -d` en local.

# --- Base de datos (PostgreSQL) ---
# Local: Docker. Producción: Neon (usa la URL "pooled" aquí y la "direct" en DIRECT_URL).
DATABASE_URL="postgresql://solena:solena@localhost:5432/solena"
DIRECT_URL="postgresql://solena:solena@localhost:5432/solena"

# --- Almacenamiento de fotos (cualquier servicio compatible con S3) ---
# Local: MinIO en Docker. Producción: Cloudflare R2.
#   R2 -> S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com", S3_REGION="auto",
#         S3_FORCE_PATH_STYLE="false", S3_PUBLIC_URL="https://<tu-subdominio>.r2.dev"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="solena"
S3_ACCESS_KEY_ID="solena"
S3_SECRET_ACCESS_KEY="solena-secreto"
S3_FORCE_PATH_STYLE="true"
# URL pública desde la que el navegador carga las fotos (sin "/" final).
S3_PUBLIC_URL="http://localhost:9000/solena"

# --- Administración ---
# Token que protege las rutas que crean, editan o borran contenido.
# Genera uno largo, por ejemplo: openssl rand -hex 32
ADMIN_TOKEN="cambia-esto-por-un-token-largo-y-aleatorio"
